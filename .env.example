# ExpenseLens AI - Environment Configuration

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expenselens

# Redis
REDIS_URL=redis://localhost:6379/0

# Groq AI (Free tier - get key at https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# App
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-random-secret-in-production

# Upload
MAX_UPLOAD_SIZE_MB=50

# Currency
BASE_CURRENCY=INR
EXCHANGE_RATE_SOURCE=RBI_REFERENCE
